#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        mute {
            bindings = <&kp K_MUTE>;
            key-positions = <11 46>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3            &kp N4    &kp N5  &kp NUMBER_6                                                                         &mo 3                  &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E             &kp R     &kp T   &kp RG(LEFT_BRACKET)                                                                 &kp LG(RIGHT_BRACKET)  &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp ESCAPE  &kp A      &kp S     &kp D             &kp F     &kp G   &mo 2                 &kp LEFT_COMMAND  &kp LSHFT      &kp RSHFT  &kp RIGHT_COMMAND  &mo 2                  &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C             &kp V     &kp B                                           &kp HOME       &kp PG_UP                                            &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 4       &kp GRAVE  &kp CAPS  &kp LEFT_CONTROL  &kp LALT          &kp BSPC              &kp DEL           &kp END        &kp PG_DN  &kp ENTER          &kp SPACE                      &kp RALT  &kp RCTRL  &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans     &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans     &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        p-vim {
            display-name = "P-Vim, Red";
            bindings = <
&trans  &trans  &trans  &trans         &kp LG(RIGHT)  &trans  &trans                                      &trans  &trans          &trans          &trans        &trans     &kp LG(LEFT)   &trans
&trans  &trans  &trans  &trans         &trans         &trans  &none                                       &none   &trans          &kp PAGE_UP     &trans        &trans     &kp BACKSPACE  &trans
&trans  &trans  &trans  &kp PAGE_DOWN  &trans         &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans         &kp DELETE
&trans  &trans  &trans  &trans         &trans         &trans                  &trans      &trans                  &trans          &trans          &trans        &trans     &trans         &trans
&trans  &trans  &trans  &trans         &trans                 &trans  &trans  &trans      &trans  &trans  &trans                  &trans          &trans        &trans     &trans         &trans
            >;
        };

        shift_fn {
            display-name = "Shift + Fn";
            bindings = <
&kp LS(F1)  &kp LS(F2)  &kp LS(F3)  &kp LS(F4)  &kp LS(F5)  &kp LS(F6)  &kp LS(F7)                                      &mo 3   &kp LS(F7)  &kp LS(F8)  &kp LS(F9)  &kp LS(F10)  &kp LS(F11)  &kp LS(F12)
&trans      &trans      &trans      &trans      &trans      &trans      &none                                           &none   &trans      &trans      &trans      &trans       &trans       &trans
&trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans  &trans      &trans  &trans  &trans  &trans      &trans      &trans      &trans       &trans       &trans
&kp LSHFT   &trans      &trans      &trans      &trans      &trans                          &trans      &trans                  &trans      &trans      &trans      &trans       &trans       &trans
&trans      &trans      &trans      &trans      &trans                  &trans      &trans  &trans      &trans  &trans  &trans              &trans      &trans      &trans       &trans       &trans
            >;
        };

        default_layer {
            display-name = "Temp";
            bindings = <
&kp EQUAL   &kp N1     &kp N2    &kp N3            &kp N3    &kp N5  &kp NUMBER_6                                                                        &mo 3                  &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E             &kp E     &kp T   &kp RG(LEFT_BRACKET)                                                                &kp LG(RIGHT_BRACKET)  &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp ESCAPE  &kp A      &kp S     &kp D             &kp D     &kp G   &mo 2                 &kp LEFT_COMMAND  &mo 5         &mo 5      &kp RIGHT_COMMAND  &mo 2                  &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C             &kp V     &kp B                                           &kp HOME      &kp PG_UP                                            &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 4       &kp GRAVE  &kp CAPS  &kp LEFT_CONTROL  &kp LEFT_CONTROL          &kp BSPC              &kp DEL           &kp END       &kp PG_DN  &kp ENTER          &kp SPACE                      &kp RALT  &kp RCTRL  &kp LBKT  &kp RBKT  &mo 4
            >;
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
